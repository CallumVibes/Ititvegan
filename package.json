{
  "name": "isitvegan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan a barcode, find out if it's vegan. Crowd-sourced over Nostr, free to read.",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "nostr-tools": "^2.10.0",
    "@noble/hashes": "^1.5.0",
    "@zxing/browser": "^0.1.5"
  }
}
